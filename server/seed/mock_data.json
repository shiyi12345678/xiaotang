  "mockQuestions": [
    {
      "id": "q-1",
      "type": "single",
      "stem": "在使用大语言模型时，「提示词（Prompt）」最核心的作用是什么？",
      "options": [
        {
          "key": "A",
          "text": "让模型运行得更快"
        },
        {
          "key": "B",
          "text": "约束并引导模型输出符合预期的结果"
        },
        {
          "key": "C",
          "text": "降低 API 调用费用"
        },
        {
          "key": "D",
          "text": "提升模型的参数量"
        }
      ],
      "answer": [
        "B"
      ],
      "analysis": "提示词的本质是「输入约束」：通过角色设定、任务描述、输出格式与示例，把模型的输出空间收窄到我们需要的范围内。它不改变模型规模与推理速度。",
      "knowledge": "提示词工程 · 基础概念"
    },
    {
      "id": "q-2",
      "type": "multiple",
      "stem": "以下哪些做法可以有效提升 AI 生成内容的质量？（多选）",
      "options": [
        {
          "key": "A",
          "text": "给出具体的输出格式要求"
        },
        {
          "key": "B",
          "text": "提供 1-2 个优质示例（Few-shot）"
        },
        {
          "key": "C",
          "text": "一次性把所有需求堆在一句话里"
        },
        {
          "key": "D",
          "text": "让模型先给出思路再给结论"
        }
      ],
      "answer": [
        "A",
        "B",
        "D"
      ],
      "analysis": "结构化约束、示例引导、分步思考都能显著提升质量；而把需求堆成一句话会稀释重点，反而更容易遗漏关键要求。",
      "knowledge": "提示词工程 · 进阶技巧"
    },
    {
      "id": "q-3",
      "type": "judge",
      "stem": "「深度思考」模式会显著增加响应时间，但对于需要推理的任务通常能提升准确率。",
      "options": [
        {
          "key": "A",
          "text": "正确"
        },
        {
          "key": "B",
          "text": "错误"
        }
      ],
      "answer": [
        "A"
      ],
      "analysis": "推理链会消耗更多生成 token，因此更慢；但在数学、逻辑、多步推理任务上准确率通常更高。",
      "knowledge": "AI 使用实践"
    }
  ],
